#!/bin/bash

# Gateway-specific values from Ansible
WgIp="{{ wireguardipaddress }}"
VxlanMac="{{ vxlanmac }}"
vxlanEndpoints=({{ vxlanendpoints }})
vxlanifname="{{ vxlanbackbonename }}"

# Static backbone VXLAN settings
vxlan_vni="25"
vxlan_dstport="4225"
vxlan_underlay_if="wg-backbone"
vxlan_mtu="1240"
batman_meshif="bat0"
throughput_override="10000mbit"


# Import shared VXLAN helper functions
source /opt/freifunk/vxlanfunctions.sh

# Ensure VXLAN interface exists
vxlan_create_if_missing \
    "$vxlanifname" \
    "$vxlan_vni" \
    "$vxlan_dstport" \
    "$vxlan_underlay_if" \
    "$VxlanMac" \
    "$vxlan_mtu"

# Ensure interface is up
vxlan_ensure_up "$vxlanifname"

# Ensure interface is part of batman-adv and marked as high-throughput backbone
vxlan_ensure_added_to_bat \
    "$vxlanifname" \
    "$batman_meshif" \
    "$throughput_override"

# Ensure VXLAN FDB contains exactly the expected remote backbone endpoints
vxlan_sync_fdb \
    "$vxlanifname" \
    "$WgIp" \
    "${vxlanEndpoints[@]}"

echo "$vxlanifname backbone VXLAN setup complete"
